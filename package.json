{
  "name": "ot-fill-out-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fills out the NU Davao Overtime Authorization Form (DVO-ADM-HRO-F-001) and computes overtime hours from attendance.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "check:ot": "tsx scripts/check-ot.ts",
    "check": "tsc -b && oxlint . && tsx scripts/check-ot.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.3.8"
  }
}
